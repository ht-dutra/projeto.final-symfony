{% extends 'base.html.twig' %}

{% set rota = app.request.attributes.get('_route') %}

{% block layout %}
    <div class="nd-app-shell">
        <header class="nd-topbar">
            <nav class="nd-nav" aria-label="Principal">
                <div class="nd-nav__left">
                    <a href="{{ path('app_app') }}" aria-label="NerdDev — início">
                        {% include '_partials/_brand.html.twig' with { comNome: true } %}
                    </a>

                    {% if app.user %}
                        <ul class="nd-nav__links">
                            <li>
                                <a href="{{ path('app_produto_index') }}" class="{{ rota == 'app_produto_index' ? 'active' }}"{% if rota == 'app_produto_index' %} aria-current="page"{% endif %}>Produtos</a>
                            </li>
                            <li>
                                <a href="{{ path('listar_categorias') }}" class="{{ rota == 'listar_categorias' ? 'active' }}"{% if rota == 'listar_categorias' %} aria-current="page"{% endif %}>Categorias</a>
                            </li>
                        </ul>
                    {% endif %}
                </div>

                <div class="nd-nav__right">
                    <button type="button" class="btn btn-sm btn-secondary nd-cart-button" aria-label="Carrinho" title="Carrinho">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
                            <circle cx="9" cy="20" r="1.4"/>
                            <circle cx="18" cy="20" r="1.4"/>
                            <path d="M3 4h2l2.4 11.2a1.5 1.5 0 0 0 1.47 1.18h8.7a1.5 1.5 0 0 0 1.47-1.18L20.5 8H6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="nd-cart-label">Carrinho</span>
                    </button>

                    {% if app.user %}
                        <span class="nd-nav__user" title="{{ app.user.userIdentifier }}">{{ app.user.userIdentifier }}</span>
                        <a class="btn btn-sm btn-secondary" href="{{ path('app_logout') }}">Sair</a>
                    {% else %}
                        <a class="btn btn-sm btn-primary" href="{{ path('app_login') }}">Entrar</a>
                    {% endif %}
                </div>
            </nav>
        </header>

        <main class="container nd-main">
            {% include '_partials/_mensagens.html.twig' %}
            {% block content %}{% endblock %}
        </main>
    </div>
{% endblock %}
