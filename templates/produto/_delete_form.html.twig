<form method="post" action="{{ path('app_produto_delete', {'id': produto.id}) }}" onsubmit="return confirm('Tem certeza que deseja excluir este produto?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produto.id) }}">
    <button class="btn btn-outline-danger">Excluir produto</button>
</form>
