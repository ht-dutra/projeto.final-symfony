{{ form_start(form, { action: form_action|default(app.request.pathInfo) }) }}
    <div class="row g-3">
        <div class="col-12 col-md-6">
            {{ form_row(form.nome) }}
        </div>
        <div class="col-12 col-md-3">
            {{ form_row(form.quantidade) }}
        </div>
        <div class="col-12 col-md-3">
            {{ form_row(form.valor) }}
        </div>
        <div class="col-12 col-md-6">
            {{ form_row(form.categoria) }}
        </div>
        <div class="col-12">
            {{ form_row(form.descricao) }}
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button class="btn btn-primary">{{ button_label|default('Salvar') }}</button>
        <a href="{{ path('app_produto_index') }}" class="btn btn-secondary">Cancelar</a>
    </div>
{{ form_end(form) }}
