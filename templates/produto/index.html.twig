{% extends 'app/base.html.twig' %}

{% block title %}Produtos{% endblock %}

{% block content %}
    <header class="nd-page-head">
        <div>
            <p class="nd-eyebrow">Catálogo</p>
            <h1 class="nd-title">Produtos</h1>
            <p class="nd-subtitle">
                {{ produtos|length }} {{ produtos|length == 1 ? 'produto cadastrado' : 'produtos cadastrados' }} no estoque.
            </p>
        </div>
        <a href="{{ path('app_produto_new') }}" class="btn btn-primary">Novo produto</a>
    </header>

    <section class="nd-panel nd-panel--flush">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Produto</th>
                        <th scope="col">Categoria</th>
                        <th scope="col">Estoque</th>
                        <th scope="col">Valor</th>
                        <th scope="col" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                {% for produto in produtos %}
                    <tr>
                        <td class="text-secondary">#{{ produto.id }}</td>
                        <td>
                            <div class="fw-semibold">{{ produto.nome }}</div>
                            <div class="small text-secondary">{{ produto.descricao }}</div>
                        </td>
                        <td>
                            <span class="nd-tag">{{ produto.categoria.nome }}</span>
                        </td>
                        <td>
                            {% if produto.quantidade > 0 %}
                                <span class="nd-badge nd-badge--success">{{ produto.quantidade }} un.</span>
                            {% else %}
                                <span class="nd-badge nd-badge--danger">Esgotado</span>
                            {% endif %}
                        </td>
                        <td class="fw-semibold">R$ {{ produto.valor|number_format(2, ',', '.') }}</td>
                        <td>
                            <div class="d-flex flex-wrap gap-1 justify-content-end">
                                <form action="{{ path('app_produto_adicionar', {id: produto.id}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('adicionar' ~ produto.id) }}">
                                    <button type="submit" class="btn btn-sm btn-secondary" title="Adicionar 1 unidade" aria-label="Adicionar 1 unidade de {{ produto.nome }}">+1</button>
                                </form>
                                <form action="{{ path('app_produto_vender', {id: produto.id}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('vender' ~ produto.id) }}">
                                    <button type="submit" class="btn btn-sm btn-secondary" title="Remover 1 unidade" aria-label="Remover 1 unidade de {{ produto.nome }}">−1</button>
                                </form>
                                <a href="{{ path('app_produto_edit', {'id': produto.id}) }}" class="btn btn-sm btn-secondary">Editar</a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6">
                            <div class="nd-empty">
                                <span class="nd-empty__icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                        <path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5z" stroke-linejoin="round"/>
                                        <path d="M4 8.5 12 13l8-4.5M12 13v7" stroke-linejoin="round"/>
                                    </svg>
                                </span>
                                <div>
                                    <p class="fw-semibold text-body mb-1">Nenhum produto cadastrado</p>
                                    <p class="mb-0">Comece adicionando o primeiro item do seu estoque.</p>
                                </div>
                                <a href="{{ path('app_produto_new') }}" class="btn btn-primary btn-sm">Cadastrar produto</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock %}
