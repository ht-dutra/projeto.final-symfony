{% extends 'app/base.html.twig' %}

{% block title %}Produtos{% endblock %}

{% block content %}
    <h1>Produtos</h1>

    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Quantidade</th>
                <th>Descrição</th>
                <th>Valor</th>
                <th>Imagem</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
        {% for produto in produtos %}
            <tr>
                <td>{{ produto.id }}</td>
                <td>{{ produto.nome }}</td>
                <td>{{ produto.categoria.nome }}</td>
                <td>{{ produto.quantidade }}</td>
                <td>{{ produto.descricao }}</td>
                <td>{{ produto.valor }}</td>
                <td><img src="{{ produto.imagemUrl|default('https://placehold.co/100') }}" alt="{{ produto.nome }}" class="img-thumbnail" style="max-width: 100px;"></td>
                <td><a href="{{ path('app_produto_edit', {'id': produto.id}) }}">Editar</a></td>
                    <form action="{{ path('app_produto_adicionar', {id: produto.id}) }}" method="post" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('adicionar' ~ produto.id) }}">
                        <button type="submit" class="btn btn-success btn-sm">+1</button>
                    </form>
                    <form action="{{ path('app_produto_vender', {id: produto.id}) }}" method="post" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('vender' ~ produto.id) }}">
                        <button type="submit" class="btn btn-warning btn-sm">−1</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">Nenhum produto cadastrado.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_produto_new') }}" class="btn btn-primary">Novo produto</a>
{% endblock %}
