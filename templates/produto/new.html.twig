{% extends 'app/base.html.twig' %}

{% block title %}Novo produto{% endblock %}

{% block content %}
    <header class="nd-page-head">
        <div>
            <p class="nd-eyebrow">Catálogo</p>
            <h1 class="nd-title">Cadastrar produto</h1>
            <p class="nd-subtitle">Preencha os dados abaixo para adicionar um item ao estoque.</p>
        </div>
        <a href="{{ path('app_produto_index') }}" class="btn btn-secondary">Voltar</a>
    </header>

    <section class="nd-panel">
        {{ include('produto/_form.html.twig', {
            button_label: 'Cadastrar',
            form_action: path('app_produto_create')
        }) }}
    </section>
{% endblock %}
