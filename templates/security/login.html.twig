{% extends 'base.html.twig' %}

{% block title %}Entrar — NerdDev Estoque{% endblock %}

{% block layout %}
    <main class="nd-auth-shell">
        <div class="nd-auth">
            <div class="nd-auth__card">
                <a href="{{ path('app_app') }}" class="nd-auth__brand" aria-label="NerdDev Estoque">
                    {% include '_partials/_brand.html.twig' %}
                </a>

                <h1 class="nd-auth__title">Entrar na conta</h1>
                <p class="nd-auth__sub">Use seu e-mail e senha para acessar o painel.</p>

                {% include '_partials/_mensagens.html.twig' %}

                {% if error %}
                    <div class="alert nd-alert--danger mb-3" role="alert">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" class="nd-auth__form">
                    <div class="mb-3">
                        <label for="username" class="form-label">E-mail</label>
                        <input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" placeholder="voce@nerddev.com" required autofocus>
                    </div>

                    <div class="mb-4">
                        <label for="password" class="form-label">Senha</label>
                        <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" placeholder="Sua senha" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-primary w-100" type="submit">Entrar</button>
                </form>

                <p class="nd-auth__foot">Acesso restrito à equipe NerdDev.</p>
            </div>
        </div>
    </main>
{% endblock %}
